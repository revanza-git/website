{
	"buildCommand": "npm run build:memory",
	"devCommand": "npm run dev",
	"installCommand": "npm ci",
	"framework": "astro",
	"outputDirectory": "dist",
	"redirects": [
		{
			"source": "/posts",
			"destination": "/blog",
			"permanent": true
		},
		{
			"source": "/post/:slug",
			"destination": "/blog/:slug",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/assets/documents/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		}
	]
}
