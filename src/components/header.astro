---
import menus from "../collections/menu.json";
import Logo from "../components/logo.astro";
---

<header
  id="header"
  class="sticky top-0 z-50 border-b border-transparent bg-paper/85 backdrop-blur-md transition-colors duration-300"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <Logo />
    <nav class="flex items-center gap-4 text-sm sm:gap-7" aria-label="Main">
      {
        menus.map((menu) => (
          <a
            href={menu.url}
            data-nav
            class="text-ink-2 transition-colors duration-200 hover:text-accent aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:underline-offset-[6px]"
          >
            {menu.name}
          </a>
        ))
      }
      <a
        href="/assets/documents/Revanza_Raytama_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden text-ink-2 transition-colors duration-200 hover:text-accent sm:inline"
      >
        Resume
      </a>
      <button
        id="darkToggle"
        type="button"
        aria-label="Toggle dark mode"
        class="-mr-1.5 flex h-8 w-8 items-center justify-center rounded-full text-ink-2 transition-colors duration-200 hover:bg-paper-2 hover:text-ink"
      >
        <svg
          class="h-[18px] w-[18px] dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
        >
        <svg
          class="hidden h-[18px] w-[18px] dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path></svg
        >
      </button>
    </nav>
  </div>
</header>
