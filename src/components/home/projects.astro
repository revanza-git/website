---
import projects from "../../collections/projects.json";
import Project from "../project.astro";

const [featured, ...rest] = projects;
const listed = rest.slice(0, 5);
---

<section class="mx-auto max-w-6xl px-5 sm:px-8" aria-labelledby="work-heading">
  <div class="flex items-end justify-between gap-6 border-b border-ink pb-4">
    <h2 id="work-heading" class="font-serif text-3xl leading-none text-ink sm:text-4xl">
      Systems in production
    </h2>
    <a href="/projects" class="link-underline text-sm text-ink-2">
      All {projects.length} case studies
    </a>
  </div>

  <a
    href={featured.url}
    class="group mt-10 grid gap-8 md:grid-cols-[1.35fr_1fr] md:items-center md:gap-12"
  >
    <span class="figure-frame block">
      <img
        src={featured.image}
        alt={featured.screenshots?.[0]?.alt ?? featured.name}
        width="1600"
        height="1000"
        class="aspect-[16/10] w-full object-cover object-top transition duration-500 group-hover:scale-[1.015]"
      />
    </span>
    <span class="block">
      <span class="label">01 &middot; Featured &middot; Live product</span>
      <span
        class="mt-4 block font-serif text-[2rem] leading-[1.08] text-ink transition-colors duration-200 group-hover:text-accent sm:text-[2.5rem]"
      >
        {featured.name}
      </span>
      <span class="mt-4 block text-base leading-7 text-ink-2">
        {featured.description}
      </span>
      <span class="mt-5 block font-mono text-[0.72rem] leading-6 text-muted">
        {featured.stacks.slice(0, 6).join(" · ")}
      </span>
      <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-ink">
        Read the case study
        <span
          class="transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true">&rarr;</span
        >
      </span>
    </span>
  </a>

  <ol class="mt-14 border-b border-rule">
    {
      listed.map((project, i) => (
        <Project
          index={i + 2}
          name={project.name}
          description={project.description}
          image={project.image}
          url={project.url}
          stacks={project.stacks}
        />
      ))
    }
  </ol>
</section>
