---
const year = new Date().getFullYear();
const links = [
  { label: "Email", href: "mailto:revanza.raytama@gmail.com" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/revanzaraytama/",
    external: true,
  },
  { label: "GitHub", href: "https://github.com/revanza-git", external: true },
  {
    label: "Resume (PDF)",
    href: "/assets/documents/Revanza_Raytama_Resume.pdf",
    external: true,
  },
];
---

<footer class="mt-24 border-t border-rule">
  <div
    class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:px-8 md:grid-cols-[1fr_auto] md:items-end"
  >
    <div>
      <p class="font-serif text-2xl leading-tight text-ink">Revanza Raytama</p>
      <p class="mt-2 text-sm text-muted">
        Senior Backend &amp; AI Systems Engineer, Jakarta
      </p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {
        links.map((link) =>
          link.external ? (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="link-underline text-ink-2"
              >
                {link.label}
              </a>
            </li>
          ) : (
            <li>
              <a href={link.href} class="link-underline text-ink-2">
                {link.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </div>
  <div class="mx-auto max-w-6xl px-5 pb-10 sm:px-8">
    <p class="label">&copy; {year} &middot; revanza.dev</p>
  </div>
</footer>
