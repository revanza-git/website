---
const { logo, dates, role, company, description } = Astro.props;
---

<article class="grid gap-3 border-b border-rule py-8 md:grid-cols-[13rem_1fr] md:gap-10">
  <p class="label pt-1.5">{dates}</p>
  <div>
    <div class="flex items-center gap-3">
      <img
        src={logo}
        alt=""
        width="32"
        height="32"
        loading="lazy"
        class="h-8 w-8 shrink-0 rounded-full border border-rule bg-white object-contain p-1"
      />
      <div>
        <h3 class="font-serif text-[1.4rem] leading-tight text-ink">{role}</h3>
        <p class="text-sm text-muted">{company}</p>
      </div>
    </div>
    <p class="mt-4 max-w-measure text-[0.98rem] leading-7 text-ink-2">{description}</p>
  </div>
</article>
