---
// One row in the editorial index of case studies.
const { index, name, description, url, image, stacks = [] } = Astro.props;
const number = String(index).padStart(2, "0");
const stackList = Array.isArray(stacks) ? stacks.slice(0, 5) : [];
---

<li class="border-t border-rule">
  <a
    href={url}
    class="group grid grid-cols-[2.25rem_1fr] gap-x-4 py-7 sm:grid-cols-[3rem_1fr_11rem] sm:gap-x-6 md:grid-cols-[3rem_1fr_11rem_14rem]"
  >
    <span class="pt-1.5 font-mono text-xs text-muted">{number}</span>
    <span class="min-w-0">
      <span
        class="flex items-baseline gap-2 font-serif text-[1.45rem] leading-tight text-ink transition-colors duration-200 group-hover:text-accent sm:text-[1.7rem]"
      >
        {name}
        <span
          class="translate-y-[-1px] font-sans text-base text-muted transition-transform duration-200 group-hover:translate-x-1 group-hover:text-accent"
          aria-hidden="true">&rarr;</span
        >
      </span>
      <span class="mt-2 block max-w-measure text-[0.95rem] leading-7 text-ink-2">
        {description}
      </span>
      <span class="mt-3 block font-mono text-[0.72rem] leading-6 text-muted md:hidden">
        {stackList.join(" · ")}
      </span>
    </span>
    <span class="hidden pt-2 font-mono text-[0.72rem] leading-6 text-muted md:block">
      {stackList.map((stack) => <span class="block">{stack}</span>)}
    </span>
    <span class="hidden sm:block">
      <img
        src={image}
        alt=""
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full rounded-[4px] border border-rule bg-paper-2 object-cover object-top transition duration-300 group-hover:border-accent"
      />
    </span>
  </a>
</li>
