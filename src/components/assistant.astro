---
// Floating "Ask about my work" assistant. The panel talks to /api/chat, the only
// server route on the site; everything it knows comes from the published case studies,
// resume and About page. Set-up runs on astro:page-load like the rest of main.js.
import assistant from "../collections/assistant.json";
import projects from "../collections/projects.json";

const suggestions = assistant.suggestedQuestions;
// Case-study URL -> name, so the widget can label links the model writes as bare paths.
const titles = Object.fromEntries(projects.map((p) => [p.url, p.name]));
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const contact = [
  { label: "Email", href: "mailto:revanza.raytama@gmail.com" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/revanzaraytama/" },
  { label: "Resume", href: "/assets/documents/Revanza_Raytama_Resume.pdf?v=20261030i" },
];
---

<div id="assistant" class="fixed bottom-5 right-5 z-40 flex flex-col items-end sm:bottom-8 sm:right-8" data-turnstile={turnstileSiteKey} data-titles={JSON.stringify(titles)}>
  <section
    id="assistant-panel"
    class="assistant-panel hidden w-[calc(100vw-2.5rem)] max-w-[25rem] flex-col overflow-hidden rounded-2xl border border-rule bg-card shadow-[0_24px_60px_-24px_rgba(22,19,15,0.4)]"
    aria-labelledby="assistant-title"
    role="dialog"
  >
    <header class="flex items-start justify-between gap-4 border-b border-rule px-5 pb-3 pt-4">
      <div>
        <p id="assistant-title" class="font-serif text-[1.15rem] leading-tight text-ink">Ask about my work</p>
        <p class="mt-1 text-xs text-muted">Grounded in the case studies and resume</p>
      </div>
      <button id="assistant-close" type="button" class="-mr-2 -mt-1 rounded-full p-1.5 text-muted transition-colors hover:bg-paper-2 hover:text-ink" aria-label="Close assistant">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
      </button>
    </header>

    <div id="assistant-log" class="flex max-h-[50vh] min-h-[15rem] flex-col gap-3 overflow-y-auto px-5 py-4 text-[0.95rem] leading-6 text-ink-2" aria-live="polite">
      <div class="assistant-intro">
        <p>Ask me anything about Revanza's projects, skills and availability, or start with one of these.</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {suggestions.map((q) => (
            <button type="button" class="assistant-suggest" data-q={q}>{q}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="px-5 pb-4 pt-1">
      <p class="mb-2.5 text-xs text-muted">
        Reach Revanza:
        {contact.map((c, i) => (
          <>
            <a href={c.href} target="_blank" rel="noopener noreferrer" class="text-ink-2 underline decoration-rule underline-offset-[3px] transition-colors hover:text-ink hover:decoration-ink">{c.label}</a>{i < contact.length - 1 ? " · " : ""}
          </>
        ))}
      </p>
      <form id="assistant-form" class="assistant-composer flex items-end gap-1.5 rounded-[1.4rem] border border-rule bg-paper py-1.5 pl-4 pr-1.5 transition-colors">
        <label for="assistant-input" class="sr-only">Your question</label>
        <textarea
          id="assistant-input"
          rows="1"
          maxlength="500"
          placeholder="Ask a question…"
          class="max-h-28 min-h-[2.25rem] flex-1 resize-none bg-transparent py-1.5 text-[0.95rem] leading-6 text-ink placeholder:text-muted focus:outline-none"
        ></textarea>
        <button id="assistant-send" type="submit" class="assistant-send flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink text-paper transition-transform hover:scale-105 active:scale-95 disabled:opacity-50 disabled:hover:scale-100" aria-label="Send">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4" /></svg>
        </button>
      </form>
      {turnstileSiteKey && <div id="assistant-turnstile" class="pt-3"></div>}
    </div>
  </section>

  <button
    id="assistant-toggle"
    type="button"
    class="assistant-toggle inline-flex items-center gap-2 rounded-full border border-ink bg-ink px-4 py-2.5 text-sm font-medium text-paper shadow-[0_10px_30px_-12px_rgba(22,19,15,0.6)]"
    aria-expanded="false"
    aria-controls="assistant-panel"
  >
    <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
    Ask about my work
  </button>
</div>

<style>
  /* Open/close: the panel scales in from the launcher's corner; the launcher slips away underneath. */
  .assistant-panel {
    transform-origin: 100% 100%;
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transition: opacity 160ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform, opacity;
  }
  .assistant-panel.is-open { opacity: 1; transform: none; }
  .assistant-toggle {
    transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 120ms ease, box-shadow 160ms ease;
  }
  .assistant-toggle:hover { transform: translateY(-2px); box-shadow: 0 14px 34px -12px rgba(22, 19, 15, 0.65); }
  .assistant-toggle:active { transform: scale(0.97); }
  .assistant-toggle.is-hidden { opacity: 0; transform: scale(0.9); pointer-events: none; position: absolute; bottom: 0; right: 0; }

  .assistant-composer:focus-within { border-color: rgb(var(--ink)); }
  .assistant-suggest {
    border: 1px solid rgb(var(--rule));
    border-radius: 999px;
    background: rgb(var(--paper-2));
    padding: 0.35rem 0.8rem;
    font-size: 0.85rem;
    line-height: 1.3;
    color: rgb(var(--ink));
    text-align: left;
    transition: border-color 120ms ease, color 120ms ease, transform 120ms ease, background-color 120ms ease;
  }
  .assistant-suggest:hover { border-color: rgb(var(--accent)); color: rgb(var(--accent)); transform: translateY(-1px); }
  .assistant-suggest:active { transform: none; }

  #assistant-log { scroll-behavior: smooth; }
  #assistant-log :global(p + p) { margin-top: 0.5rem; }
  #assistant-log :global(ul.answer-list) { margin-top: 0.5rem; padding-left: 1.1rem; list-style: disc; }
  #assistant-log :global(ul.answer-list + p) { margin-top: 0.6rem; }
  #assistant-log :global(a) { color: rgb(var(--ink)); text-decoration: underline; text-decoration-color: rgb(var(--rule)); text-underline-offset: 3px; }
  #assistant-log :global(a:hover) { text-decoration-color: rgb(var(--ink)); }
  #assistant-log :global(.msg-user) { align-self: flex-end; max-width: 85%; border-radius: 1rem 1rem 0.25rem 1rem; background: rgb(var(--accent) / 0.09); padding: 0.5rem 0.85rem; color: rgb(var(--ink)); }
  #assistant-log :global(.msg-assistant) { max-width: 95%; }
  #assistant-log :global(.msg-user), #assistant-log :global(.msg-assistant) { animation: assistant-in 180ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  #assistant-log :global(.msg-sources) { margin-top: 0.6rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; font-size: 0.72rem; color: rgb(var(--muted)); }
  #assistant-log :global(.msg-sources a) { border: 1px solid rgb(var(--rule)); border-radius: 999px; padding: 0.1rem 0.55rem; text-decoration: none; color: rgb(var(--ink-2)); transition: border-color 120ms ease, color 120ms ease; }
  #assistant-log :global(.msg-sources a:hover) { border-color: rgb(var(--accent)); color: rgb(var(--accent)); }
  #assistant-log :global(.msg-error) { color: rgb(var(--accent)); }
  #assistant-log :global(.thinking) { display: inline-flex; align-items: center; gap: 0.3rem; color: rgb(var(--muted)); }
  #assistant-log :global(.thinking i) { width: 5px; height: 5px; border-radius: 999px; background: rgb(var(--accent)); animation: assistant-dot 900ms ease-in-out infinite; }
  #assistant-log :global(.thinking i:nth-child(2)) { animation-delay: 150ms; }
  #assistant-log :global(.thinking i:nth-child(3)) { animation-delay: 300ms; }
  #assistant-log :global(.cursor > :last-child::after) { content: "▍"; margin-left: 2px; color: rgb(var(--accent)); animation: assistant-blink 900ms steps(2) infinite; }

  @keyframes assistant-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes assistant-blink { 50% { opacity: 0; } }
  @keyframes assistant-dot { 0%, 100% { opacity: 0.25; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-2px); } }

  @media (prefers-reduced-motion: reduce) {
    .assistant-panel, .assistant-toggle, .assistant-suggest { transition: none; }
    #assistant-log :global(.msg-user), #assistant-log :global(.msg-assistant), #assistant-log :global(.thinking i) { animation: none; }
    #assistant-log { scroll-behavior: auto; }
  }
</style>

<script>
  type Msg = { role: "user" | "assistant"; content: string };
  const STORAGE = "assistant_messages";
  const OPEN_KEY = "assistant_open";
  const MAX_HISTORY = 6;

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c);

  // Case-study URL -> name, filled in by setup() from the data-titles attribute.
  let titles: Record<string, string> = {};
  const anchor = (url: string, label: string) =>
    `<a href="${url}" target="_blank" rel="noopener noreferrer">${label}</a>`;
  // Minimal, safe markdown: paragraphs, "- " bullets, **bold**, [text](url) with a URL allowlist.
  // The model occasionally writes a case-study path bare or in square brackets; those become
  // links labelled with the case study's name.
  const render = (text: string) => {
    const inline = (s: string) =>
      escapeHtml(s)
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, label, url) => {
          if (!/^(\/|https?:\/\/|mailto:)/.test(url)) return label;
          const name = titles[url];
          return anchor(url, name && label.startsWith("/") ? name : label);
        })
        .replace(/\[(\/projects\/[a-z0-9-]+)\]/g, (_m, url) => anchor(url, titles[url] ?? "case study"))
        .replace(/(^|[\s(])(\/projects\/[a-z0-9-]+)(?=$|[\s).,;:])/g, (_m, before, url) => `${before}${anchor(url, titles[url] ?? "case study")}`);
    const blocks = text.trim().split(/\n{2,}/);
    return blocks
      .map((block) => {
        const lines = block.split("\n");
        if (lines.every((l) => /^\s*[-*]\s+/.test(l))) {
          return `<ul class="answer-list">${lines.map((l) => `<li>${inline(l.replace(/^\s*[-*]\s+/, ""))}</li>`).join("")}</ul>`;
        }
        return `<p>${lines.map(inline).join("<br>")}</p>`;
      })
      .join("");
  };

  const read = (key: string) => {
    try {
      return sessionStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const write = (key: string, value: string) => {
    try {
      sessionStorage.setItem(key, value);
    } catch {
      // storage unavailable: state lives for this page only
    }
  };
  const load = (): Msg[] => {
    try {
      return JSON.parse(read(STORAGE) ?? "[]");
    } catch {
      return [];
    }
  };

  const setup = () => {
    const root = document.getElementById("assistant");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";
    const panel = document.getElementById("assistant-panel")!;
    const toggle = document.getElementById("assistant-toggle")!;
    const close = document.getElementById("assistant-close")!;
    const log = document.getElementById("assistant-log")!;
    const form = document.getElementById("assistant-form") as HTMLFormElement;
    const input = document.getElementById("assistant-input") as HTMLTextAreaElement;
    const send = document.getElementById("assistant-send") as HTMLButtonElement;
    const intro = log.querySelector(".assistant-intro") as HTMLElement | null;
    try {
      titles = JSON.parse(root.dataset.titles ?? "{}");
    } catch {
      titles = {};
    }
    let messages = load();
    let busy = false;

    const open = (show: boolean, instant = false) => {
      toggle.setAttribute("aria-expanded", String(show));
      write(OPEN_KEY, show ? "1" : "0");
      if (show) {
        panel.classList.remove("hidden");
        panel.classList.add("flex");
        toggle.classList.add("is-hidden");
        // Two frames so the transition runs from the hidden state.
        if (instant) panel.classList.add("is-open");
        else requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add("is-open")));
        if (!instant) setTimeout(() => input.focus({ preventScroll: true }), 120);
      } else {
        panel.classList.remove("is-open");
        toggle.classList.remove("is-hidden");
        const finish = () => {
          panel.classList.add("hidden");
          panel.classList.remove("flex");
        };
        if (instant || matchMedia("(prefers-reduced-motion: reduce)").matches) finish();
        else panel.addEventListener("transitionend", finish, { once: true });
      }
    };
    toggle.addEventListener("click", () => open(true));
    close.addEventListener("click", () => open(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && panel.classList.contains("is-open")) open(false);
    });

    // The composer grows with the question, up to its max height.
    const autosize = () => {
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 112)}px`;
    };
    input.addEventListener("input", autosize);

    const bubble = (role: Msg["role"], html: string) => {
      const el = document.createElement("div");
      el.className = role === "user" ? "msg-user" : "msg-assistant";
      el.innerHTML = html;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    };
    const showSources = (el: HTMLElement, header: string | null) => {
      if (!header) return;
      try {
        const sources = JSON.parse(decodeURIComponent(header)) as { title: string; url: string }[];
        if (!sources.length) return;
        const p = document.createElement("p");
        p.className = "msg-sources";
        p.innerHTML = `<span>From</span>${sources.map((s) => `<a href="${escapeHtml(s.url)}">${escapeHtml(s.title)}</a>`).join("")}`;
        el.appendChild(p);
      } catch {
        // malformed header: skip the source line
      }
    };

    // Restore an earlier conversation and the open state from this session (page navigations keep both).
    if (messages.length && intro) intro.remove();
    for (const m of messages) bubble(m.role, m.role === "user" ? escapeHtml(m.content) : render(m.content));
    if (read(OPEN_KEY) === "1") open(true, true);

    const turnstileToken = () => {
      const field = root.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
      return field?.value ?? "";
    };

    const ask = async (question: string) => {
      const q = question.trim();
      if (!q || busy) return;
      busy = true;
      send.disabled = true;
      input.value = "";
      autosize();
      intro?.remove();
      bubble("user", escapeHtml(q));
      messages.push({ role: "user", content: q });
      const el = bubble("assistant", '<p class="thinking"><i></i><i></i><i></i></p>');
      let answer = "";
      try {
        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ messages: messages.slice(-MAX_HISTORY), turnstileToken: turnstileToken() }),
        });
        if (!res.ok || !res.body) {
          const data = await res.json().catch(() => ({}));
          el.innerHTML = `<p class="msg-error">${escapeHtml(data.error ?? "Something went wrong.")}</p>`;
          messages.pop();
          return;
        }
        el.classList.add("cursor");
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          answer += decoder.decode(value, { stream: true });
          el.innerHTML = render(answer);
          log.scrollTop = log.scrollHeight;
        }
        el.innerHTML = render(answer);
        showSources(el, res.headers.get("x-assistant-sources"));
        messages.push({ role: "assistant", content: answer });
        write(STORAGE, JSON.stringify(messages.slice(-MAX_HISTORY)));
      } catch {
        el.innerHTML = '<p class="msg-error">The assistant is unavailable right now. Please try again later.</p>';
        messages.pop();
      } finally {
        el.classList.remove("cursor");
        busy = false;
        send.disabled = false;
        input.focus({ preventScroll: true });
      }
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      ask(input.value);
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        ask(input.value);
      }
    });
    for (const button of root.querySelectorAll<HTMLButtonElement>(".assistant-suggest")) {
      button.addEventListener("click", () => ask(button.dataset.q ?? ""));
    }

    // Optional Cloudflare Turnstile: rendered only when a site key is configured.
    const siteKey = root.dataset.turnstile;
    const holder = document.getElementById("assistant-turnstile");
    if (siteKey && holder && !document.querySelector("script[data-turnstile]")) {
      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.dataset.turnstile = "true";
      script.onload = () => (window as any).turnstile?.render(holder, { sitekey: siteKey, size: "flexible" });
      document.head.appendChild(script);
    }
  };

  document.addEventListener("astro:page-load", setup);
</script>
