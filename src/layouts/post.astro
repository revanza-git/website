---
import Layout from "./main.astro";
const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <main class="mx-auto max-w-3xl px-5 pt-12 sm:px-8 sm:pt-20">
    <h1
      class="font-serif text-[2.4rem] leading-[1.06] tracking-[-0.02em] text-ink [text-wrap:balance] sm:text-[3.2rem]"
    >
      {frontmatter.title}
    </h1>
    <article
      class="prose prose-lg mt-10 max-w-none border-t border-rule pt-10 prose-headings:font-serif prose-headings:font-normal prose-a:text-accent dark:prose-invert"
    >
      <slot />
    </article>
  </main>
</Layout>
