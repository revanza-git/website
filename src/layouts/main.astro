---
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import "../assets/css/main.css";
const {
  title,
  description = "Revanza Raytama is a Senior Backend & AI Systems Engineer in Jakarta building enterprise backend, data, and LLM/RAG systems for energy, telecom, and insurance operations.",
  image = "/assets/images/og-default.png",
  imageAlt = "Revanza Raytama, Senior Backend & AI Systems Engineer",
  type = "website",
} = Astro.props;
const siteUrl = Astro.site ?? new URL("https://revanza.dev");
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const imageURL = new URL(image, siteUrl).href;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Revanza Raytama",
  url: siteUrl.href,
  image: new URL("/assets/images/revanza-raytama.jpg", siteUrl).href,
  jobTitle: "Senior Backend & AI Systems Engineer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Jakarta",
    addressCountry: "ID",
  },
  sameAs: [
    "https://www.linkedin.com/in/revanzaraytama/",
    "https://github.com/revanza-git",
  ],
};
const allowHtmlInject = import.meta.env.ENABLE_HTML_INJECT === "true";
const headerInject = allowHtmlInject ? import.meta.env.HEADER_INJECT : "";
const footerInject = allowHtmlInject ? import.meta.env.FOOTER_INJECT : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Revanza Raytama" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / social link previews -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Revanza Raytama" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {
      Astro.url.pathname === "/" && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(personSchema)}
        />
      )
    }

    <!-- Apply the saved (or system) colour scheme before paint to avoid a flash -->
    <script is:inline>
      try {
        const stored = localStorage.getItem("dark_mode");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "true" || (stored === null && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      } catch (e) {}
    </script>
    <meta name="theme-color" content="#F6F3EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12110F" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
    />
    <link rel="icon" type="image/x-icon" href="/assets/images/favicon.png" />
    {allowHtmlInject && <Fragment set:html={headerInject} />}
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <Header />
    <slot />
    <Footer />
    <script src="../assets/js/main.js"></script>
    {allowHtmlInject && <Fragment set:html={footerInject} />}
  </body>
</html>
