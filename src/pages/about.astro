---
import about from "../collections/about.json";
import experiences from "../collections/experiences.json";
import AboutExperience from "../components/about-experience.astro";
import PageHeading from "../components/page-heading.astro";
import ScheduleMeeting from "../components/schedule-meeting.astro";
import Layout from "../layouts/main.astro";

const { strengths, contactLinks } = about;
---

<Layout
  title="About Revanza Raytama | Backend & AI Systems Engineer"
  description="About Revanza Raytama, Senior Backend & AI Systems Engineer in Jakarta: 9+ years building workflow platforms, data pipelines, and production AI features for energy, telecom, and insurance, leading 7 Agile squads."
>
  <main class="mx-auto max-w-6xl px-5 pt-12 sm:px-8 sm:pt-20">
    <PageHeading
      label="About"
      title="About Revanza"
      description="Senior Backend & AI Systems Engineer from Jakarta with 9+ years building enterprise workflow platforms, data pipelines, and production AI features. I work best where software has to connect messy operations, legacy systems, reporting needs, and real production constraints."
    />

    <figure class="figure-frame mt-12">
      <img
        src="/assets/images/revanza-raytama-wide.jpg"
        alt="Revanza Raytama"
        width="1600"
        height="900"
        class="w-full"
      />
    </figure>

    <div class="mt-16 border-t border-ink">
      <section class="grid gap-4 border-b border-rule py-10 md:grid-cols-[13rem_1fr] md:gap-10">
        <h2 class="font-serif text-2xl text-ink">Profile</h2>
        <p class="max-w-measure text-[1.05rem] leading-8 text-ink-2">
          My recent work sits across <strong class="font-medium text-ink"
            >backend architecture</strong
          >, <strong class="font-medium text-ink">AI/RAG systems</strong>, and
          <strong class="font-medium text-ink">data platforms</strong> for energy, insurance,
          and telecom. In the last year I designed and built a permit-to-work platform that now
          handles around 1,000 permits a month, led a document governance platform whose AI
          module drafts procedures in minutes instead of a week, and took an on-premise RAG
          assistant into production. Before that I built governed reporting stores from 30+
          internal databases and the industrial data pipelines that removed manual Excel
          workflows.
        </p>
      </section>

      <section class="grid gap-4 border-b border-rule py-10 md:grid-cols-[13rem_1fr] md:gap-10">
        <h2 class="font-serif text-2xl text-ink">Strengths</h2>
        <ol class="max-w-measure">
          {
            strengths.map((strength, i) => (
              <li class="grid grid-cols-[2.25rem_1fr] border-b border-rule py-4 text-[1rem] leading-7 text-ink-2 first:pt-0 last:border-b-0 last:pb-0">
                <span class="pt-[3px] font-mono text-xs text-muted">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>{strength}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="pt-10" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="font-serif text-2xl text-ink">Experience</h2>
        <div class="mt-2">
          {
            experiences.map((experience) => (
              <AboutExperience
                dates={experience.dates}
                role={experience.role}
                company={experience.company}
                description={experience.description}
                logo={experience.logo}
              />
            ))
          }
        </div>
      </section>

      <section class="grid gap-4 py-10 md:grid-cols-[13rem_1fr] md:gap-10">
        <h2 class="font-serif text-2xl text-ink">Let's connect</h2>
        <div class="max-w-measure">
          <p class="text-[1.05rem] leading-8 text-ink-2">
            For hiring, collaboration, or technical conversations, these are the fastest ways
            to review my background and reach me.
          </p>
          <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {
              contactLinks.map((link) =>
                link.external ? (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-underline text-ink"
                    >
                      {link.label}
                    </a>
                  </li>
                ) : (
                  <li>
                    <a href={link.href} class="link-underline text-ink">
                      {link.label}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
          <div class="mt-6">
            <ScheduleMeeting />
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
