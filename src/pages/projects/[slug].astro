---
import projects from "../../collections/projects.json";
import Layout from "../../layouts/main.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Figure = { src: string; alt: string; caption?: string };

const { project } = Astro.props;
const position = projects.findIndex((item) => item.slug === project.slug);
const number = String(position + 1).padStart(2, "0");
const total = String(projects.length).padStart(2, "0");
const next = projects[(position + 1) % projects.length];
const architecture = (project as { architecture?: Figure }).architecture;
const screenshots: Figure[] = project.screenshots ?? [];
const heroAlt = screenshots[0]?.alt ?? project.name;
const gallery = screenshots.slice(1);
const proof: string[] = project.proof ?? [];
// Social previews (LinkedIn etc.) only reliably accept PNG/JPEG, so WebP heroes fall back to the default card.
const ogImage = /\.(png|jpe?g)$/i.test(project.image) ? project.image : undefined;
---

<Layout
  title={`${project.name} | Project Case Study`}
  description={project.description}
  image={ogImage}
  imageAlt={ogImage ? heroAlt : undefined}
  type="article"
>
  <main class="mx-auto max-w-6xl px-5 pt-10 sm:px-8 sm:pt-14">
    <a href="/projects" class="label inline-flex items-center gap-2 hover:text-accent">
      <span aria-hidden="true">&larr;</span> All case studies
    </a>

    <header class="mt-10 max-w-4xl">
      <p class="label">Case study {number} / {total}</p>
      <h1
        class="mt-5 font-serif text-[2.4rem] leading-[1.04] tracking-[-0.02em] text-ink [text-wrap:balance] sm:text-[3.6rem]"
      >
        {project.name}
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-ink-2 sm:text-xl sm:leading-9">
        {project.description}
      </p>
    </header>

    <dl class="mt-10 grid gap-6 border-y border-rule py-6 sm:grid-cols-[1fr_auto] sm:gap-10">
      <div>
        <dt class="label">Stack</dt>
        <dd class="mt-2 font-mono text-[0.78rem] leading-6 text-ink-2">
          {project.stacks.join(" · ")}
        </dd>
      </div>
      {
        project.links.length > 0 && (
          <div>
            <dt class="label">Links</dt>
            <dd class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm">
              {project.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline text-ink"
                >
                  {link.label} <span aria-hidden="true">&#8599;</span>
                </a>
              ))}
            </dd>
          </div>
        )
      }
    </dl>

    <figure class="figure-frame mt-10">
      <img src={project.image} alt={heroAlt} class="w-full object-cover" />
    </figure>

    <div class="mt-16 border-t border-ink">
      <section class="grid gap-4 border-b border-rule py-10 md:grid-cols-[13rem_1fr] md:gap-10">
        <h2 class="font-serif text-2xl text-ink">The problem</h2>
        <p class="max-w-measure text-[1.05rem] leading-8 text-ink-2">{project.problem}</p>
      </section>

      <section class="grid gap-4 border-b border-rule py-10 md:grid-cols-[13rem_1fr] md:gap-10">
        <h2 class="font-serif text-2xl text-ink">What I built</h2>
        <p class="max-w-measure text-[1.05rem] leading-8 text-ink-2">{project.solution}</p>
      </section>

      {
        gallery.length > 0 && (
          <section class="border-b border-rule py-10" aria-label="More screenshots">
            <div class="grid gap-4 md:grid-cols-[13rem_1fr] md:gap-10">
              <h2 class="font-serif text-2xl text-ink">In use</h2>
              <div class={`grid gap-4 ${gallery.length > 1 ? "sm:grid-cols-2" : "sm:grid-cols-[minmax(0,32rem)]"}`}>
                {gallery.map((shot) => (
                  <figure class="figure-frame">
                    <img src={shot.src} alt={shot.alt} loading="lazy" class="w-full object-cover" />
                    <figcaption class="border-t border-rule px-3 py-2 text-xs leading-5 text-muted">{shot.alt}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {
        architecture && (
          <section class="border-b border-rule py-10">
            <div class="grid gap-4 md:grid-cols-[13rem_1fr] md:gap-10">
              <h2 class="font-serif text-2xl text-ink">Architecture</h2>
              {architecture.caption && (
                <p class="max-w-measure text-[1.05rem] leading-8 text-ink-2">
                  {architecture.caption}
                </p>
              )}
            </div>
            <figure class="figure-frame mt-8">
              <a href={architecture.src} target="_blank" rel="noopener noreferrer" class="block">
                <img
                  src={architecture.src}
                  alt={architecture.alt}
                  loading="lazy"
                  class="w-full"
                />
              </a>
            </figure>
            <p class="label mt-3">Open the image for full size</p>
          </section>
        )
      }

      <section class="grid gap-4 border-b border-rule py-10 md:grid-cols-[13rem_1fr] md:gap-10">
        <h2 class="font-serif text-2xl text-ink">Proof</h2>
        <ol class="max-w-measure">
          {
            proof.map((point, i) => (
              <li class="grid grid-cols-[2.25rem_1fr] border-b border-rule py-4 text-[1rem] leading-7 text-ink-2 first:pt-0 last:border-b-0 last:pb-0">
                <span class="pt-[3px] font-mono text-xs text-muted">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>{point}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="grid gap-4 py-10 md:grid-cols-[13rem_1fr] md:gap-10">
        <h2 class="font-serif text-2xl text-ink">Result</h2>
        <p
          class="max-w-measure border-l-2 border-accent pl-5 font-serif text-[1.35rem] leading-[1.5] text-ink sm:text-[1.5rem]"
        >
          {project.result}
        </p>
      </section>
    </div>

    <nav class="mt-10 border-t border-ink pt-8" aria-label="Next case study">
      <a href={next.url} class="group flex flex-wrap items-end justify-between gap-4">
        <span>
          <span class="label">Next case study</span>
          <span
            class="mt-3 block font-serif text-[1.9rem] leading-tight text-ink transition-colors duration-200 group-hover:text-accent sm:text-[2.4rem]"
          >
            {next.name}
          </span>
        </span>
        <span
          class="pb-2 text-2xl text-muted transition-transform duration-200 group-hover:translate-x-1 group-hover:text-accent"
          aria-hidden="true">&rarr;</span
        >
      </a>
    </nav>
  </main>
</Layout>
