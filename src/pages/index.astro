---
import home from "../collections/home.json";
import Projects from "../components/home/projects.astro";
import Layout from "../layouts/main.astro";

const { metrics, practice } = home;
---

<Layout title="Revanza Raytama | Senior Backend & AI Systems Engineer">
  <main>
    <section class="mx-auto max-w-6xl px-5 pb-16 pt-12 sm:px-8 sm:pt-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_15rem] lg:items-end lg:gap-16">
        <div>
          <p class="label rise">Senior Backend &amp; AI Engineer &middot; Jakarta</p>
          <h1
            class="rise mt-6 max-w-[17ch] font-serif text-[2.7rem] font-normal leading-[1.02] tracking-[-0.025em] text-ink [text-wrap:balance] sm:text-6xl lg:text-[4.4rem]"
            style="--rise-i: 1"
          >
            Backend, data and AI systems that hold up in <em
              class="italic text-accent">real operations</em
            >.
          </h1>
          <p
            class="rise mt-7 max-w-[38rem] text-lg leading-8 text-ink-2 [text-wrap:pretty]"
            style="--rise-i: 2"
          >
            I'm Revanza Raytama. For more than eight years I've built platforms for energy,
            telecom and insurance. Today I lead technical delivery at a Pertamina
            subsidiary, and I co-founded
            <a href="/projects/meatlink-b2b-meat-commerce" class="link-underline text-ink"
              >MeatLink</a
            >, where I run the technology.
          </p>
          <div class="rise mt-9 flex flex-wrap items-center gap-x-6 gap-y-4" style="--rise-i: 3">
            <a
              href="/assets/documents/Revanza_Raytama_Resume.pdf?v=20261020"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ink"
            >
              Resume (PDF)
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14"></path></svg
              >
            </a>
            <a
              href="https://github.com/revanza-git"
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline text-sm text-ink-2">GitHub</a
            >
            <a
              href="https://www.linkedin.com/in/revanzaraytama/"
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline text-sm text-ink-2">LinkedIn</a
            >
            <a href="mailto:revanza.raytama@gmail.com" class="link-underline text-sm text-ink-2"
              >revanza.raytama@gmail.com</a
            >
          </div>
        </div>

        <figure class="rise hidden w-full lg:block" style="--rise-i: 2">
          <div class="figure-frame">
            <img
              src="/assets/images/revanza-raytama.jpg"
              alt="Portrait of Revanza Raytama"
              width="960"
              height="1200"
              loading="eager"
              decoding="async"
              class="aspect-[4/5] w-full object-cover"
            />
          </div>
          <figcaption class="label mt-3">Revanza Raytama, Jakarta</figcaption>
        </figure>
      </div>

      <dl
        class="rise mt-16 grid grid-cols-2 gap-px border-y border-rule bg-rule md:grid-cols-4"
        style="--rise-i: 4"
      >
        {
          metrics.map((metric, i) => (
            <div class={`bg-paper py-5 pr-4 ${i % 2 === 1 ? "pl-5" : ""} ${i > 0 ? "md:pl-6" : ""}`}>
              <dt class="sr-only">{metric.label}</dt>
              <dd class="font-serif text-[2.1rem] leading-none text-ink">{metric.value}</dd>
              <dd class="mt-2 text-[0.8rem] leading-5 text-muted">{metric.label}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <Projects />

    <section
      class="mx-auto mt-24 max-w-6xl px-5 sm:px-8"
      aria-labelledby="practice-heading"
      data-reveal
    >
      <div class="border-b border-ink pb-4">
        <h2 id="practice-heading" class="font-serif text-3xl leading-none text-ink sm:text-4xl">
          What I work on
        </h2>
      </div>
      <div class="grid gap-px border-b border-rule bg-rule sm:grid-cols-2 lg:grid-cols-4">
        {
          practice.map((item, i) => (
            <article class={`bg-paper py-7 sm:px-6 ${i % 2 === 0 ? "sm:pl-0" : ""} ${i > 0 ? "lg:pl-6" : ""}`}>
              <p class="font-mono text-xs text-muted">{String(i + 1).padStart(2, "0")}</p>
              <h3 class="mt-3 font-serif text-[1.45rem] leading-tight text-ink">{item.title}</h3>
              <p class="mt-3 text-[0.95rem] leading-7 text-ink-2">{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mx-auto mt-24 max-w-6xl px-5 sm:px-8">
      <div class="rounded-[6px] border border-rule bg-card px-6 py-12 sm:px-12 sm:py-16" data-reveal>
        <p class="label">Open to senior backend and AI engineering roles</p>
        <p
          class="mt-5 max-w-3xl font-serif text-[2rem] leading-[1.12] text-ink [text-wrap:balance] sm:text-[2.6rem]"
        >
          Building something that has to work on Monday morning? Let's talk.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="mailto:revanza.raytama@gmail.com" class="btn-ink">Email me</a>
          <a href="/about" class="link-underline text-sm text-ink-2">More about me</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
