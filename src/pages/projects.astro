---
import projects from "../collections/projects.json";
import Project from "../components/project.astro";
import Layout from "../layouts/main.astro";
---

<Layout
  title="Project Case Studies | Revanza Raytama"
  description="Case studies of AI, backend, and data-platform systems built by Revanza Raytama, from an agent-ready B2B commerce platform to enterprise RAG, risk monitoring, and executive data pipelines."
>
  <main class="mx-auto max-w-6xl px-5 pt-12 sm:px-8 sm:pt-20">
    <header class="max-w-3xl">
      <p class="label">Work &middot; {projects.length} case studies</p>
      <h1
        class="mt-6 font-serif text-[2.6rem] leading-[1.04] tracking-[-0.02em] text-ink sm:text-6xl"
      >
        Case studies
      </h1>
      <p class="mt-6 text-lg leading-8 text-ink-2">
        AI, backend and data-platform work, each told the same way: the problem,
        the architecture, the proof and the result.
      </p>
    </header>

    <ol class="mt-14 border-b border-rule">
      {
        projects.map((project, i) => (
          <Project
            index={i + 1}
            name={project.name}
            description={project.description}
            image={project.image}
            url={project.url}
            stacks={project.stacks}
          />
        ))
      }
    </ol>
  </main>
</Layout>
