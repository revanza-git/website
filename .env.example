# Runtime (local dev)
NODE_ENV=development
HOST=0.0.0.0
PORT=4321

# Contact form relay (optional but recommended)
FORMSPREE_ENDPOINT=

# Sanity content
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Optional metadata overrides
SITE_URL=https://revanza.vercel.app
FEED_URL=https://revanza.vercel.app/rss.xml
BLOG_URL=https://revanza.vercel.app/blog

# Optional HTML injections used by legacy layout
ENABLE_HTML_INJECT=false
HEADER_INJECT=
FOOTER_INJECT=

# Portfolio assistant (/api/chat). Groq free tier; the key never reaches the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional Cloudflare Turnstile. Leave both empty to disable the check.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
